# Copy to .env (make up does this for you). Local development credentials only.
COMPOSE_PROJECT_NAME=lakehouse-cdc

# Host ports. Chosen to stay clear of common defaults (5432, 8080, 9092, ...).
PG_PORT=15432
KAFKA_PORT=19092
CONNECT_PORT=18083
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
ICEBERG_REST_PORT=18181
TRINO_PORT=18080
SPARK_UI_PORT=14040

# Postgres (source OLTP)
POSTGRES_DB=servicing
POSTGRES_USER=servicing
POSTGRES_PASSWORD=servicing
CDC_USER=cdc_reader
CDC_PASSWORD=cdc_reader

# MinIO (S3)
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=lakehouse-secret
S3_BUCKET=warehouse

# Streaming job
CDC_MAX_OFFSETS_PER_TRIGGER=20000
CDC_TRIGGER_INTERVAL="2 seconds"

# Workload used by make demo / make chaos
DEMO_SEED=42
DEMO_OPS=20000
DEMO_RATE=250
CHAOS_SEED=7
CHAOS_OPS=20000
CHAOS_RATE=250
